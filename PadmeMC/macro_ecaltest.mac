/control/verbose 1 
/run/verbose 1	    
/tracking/verbose 0	 
#Detector and line configuration
/Detector/Setup 40
/output/DataFileName output/data_y0.root
/output/HistoFileName output/histo_y0.root
#/Detector/EnableStructure BeamLine
/Detector/SetMagneticFieldValue 0.0001 tesla
#/Detector/BeamLine/DHSTB001_FieldY -0.5455 tesla
#/Detector/BeamLine/DHSTB002_FieldY -0.5455 tesla
#/Detector/BeamLine/EnableQuadrupoles true
#/Detector/BeamLine/Q1_FieldGrad  3.082
#/Detector/BeamLine/Q2_FieldGrad  2.234
#/Detector/BeamLine/Q3_FieldGrad  2.345
#/Detector/BeamLine/Q4_FieldGrad  2.530
#/Detector/BeamLine/SLTB2Aperture 1.7 mm
#/Detector/BeamLine/SLTB3Aperture 4.3 mm
#/Detector/BeamLine/SLTB4Aperture 2.1 mm
#/Detector/BeamLine/SLTB5Aperture 5.  mm

/Detector/DisableSubDetector ECal
/Detector/DisableSubDetector Target
/Detector/DisableSubDetector SAC
/Detector/DisableSubDetector PVeto
/Detector/DisableSubDetector EVeto
/Detector/DisableSubDetector HEPVeto
/Detector/DisableSubDetector TDump
#/Detector/DisableSubDetector TPix
/Detector/DisableSubDetector ETag
/Detector/DisableSubDetector LeadGlass

#/Detector/DisableStructure Magnet
#/Detector/DisableStructure Chamber
/Detector/DisableStructure BeamLine

/run/initialize 

/beam/n_e+_per_bunch 3000
/beam/n_e+_poisson_on false
/beam/bunch_time_length 10. ns
/beam/momentum 285.0 MeV
/beam/position_spread_on true
/beam/position_x_spread 5. mm
/beam/position_y_spread 5. mm
/beam/momentum_spread_on true
/beam/momentum_spread 1.0 MeV
/beam/emittance_on false
/beam/emittance_x 2. mrad
/beam/emittance_y 2. mrad

#STARTING at the center of the magnet
/beam/position_x 0 mm
/beam/position_y 0 mm
/beam/position_z 0.0 mm
/beam/direction  0. 0. 1.

#STARTING AT THE MYLAR WINDOW POSTION
#/beam/position_x 7233. mm
#/beam/position_y 0. cm
#/beam/position_z -9581. mm
#/beam/direction -1. 0. 1.

#STARTING AT exit of DHSTB001
#/beam/position_x 7833.494317 mm
#/beam/position_y 0. cm
#/beam/position_z -10182.154317 mm
#/beam/direction -1. 0. 1.


#STARTING Before BTF Target
#/beam/position_x 12610. mm
#/beam/position_y 0. cm
#/beam/position_z -10833.15 mm
#/beam/direction -1. 0. 0.

